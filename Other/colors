/* CSS HEX */
--midnight-violet: #331832ff;
--raspberry-red: #d81e5bff;
--cinnabar: #f0544fff;
--ash-grey: #c6d8d3ff;
--papaya-whip: #fdf0d5ff;

/* CSS HSL */
--midnight-violet: hsla(302, 36%, 15%, 1);
--raspberry-red: hsla(340, 76%, 48%, 1);
--cinnabar: hsla(2, 84%, 63%, 1);
--ash-grey: hsla(163, 19%, 81%, 1);
--papaya-whip: hsla(40, 91%, 91%, 1);

/* SCSS HEX */
$midnight-violet: #331832ff;
$raspberry-red: #d81e5bff;
$cinnabar: #f0544fff;
$ash-grey: #c6d8d3ff;
$papaya-whip: #fdf0d5ff;

/* SCSS HSL */
$midnight-violet: hsla(302, 36%, 15%, 1);
$raspberry-red: hsla(340, 76%, 48%, 1);
$cinnabar: hsla(2, 84%, 63%, 1);
$ash-grey: hsla(163, 19%, 81%, 1);
$papaya-whip: hsla(40, 91%, 91%, 1);

/* SCSS RGB */
$midnight-violet: rgba(51, 24, 50, 1);
$raspberry-red: rgba(216, 30, 91, 1);
$cinnabar: rgba(240, 84, 79, 1);
$ash-grey: rgba(198, 216, 211, 1);
$papaya-whip: rgba(253, 240, 213, 1);

/* SCSS Gradient */
$gradient-top: linear-gradient(0deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-right: linear-gradient(90deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-bottom: linear-gradient(180deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-left: linear-gradient(270deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-top-right: linear-gradient(45deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-bottom-right: linear-gradient(135deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-top-left: linear-gradient(225deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-bottom-left: linear-gradient(315deg, #331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);
$gradient-radial: radial-gradient(#331832ff, #d81e5bff, #f0544fff, #c6d8d3ff, #fdf0d5ff);